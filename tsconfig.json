{
    "compilerOptions": {
        "module": "esnext",
        "target": "ES2017",
        "experimentalDecorators": false,
        "emitDecoratorMetadata": false,
        "useDefineForClassFields": false,
        "lib": [
            "dom",
            "es2017",
            "es2015",
            "es5",
            "es6",
            "es7"
        ],
        "importHelpers": false,
        "strict": true,
        "strictPropertyInitialization": false,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "noImplicitReturns": true,
        "noImplicitOverride" : true,
        "noEmit": true,
        "strictNullChecks": true,
        "removeComments": true,
        "paths": {
            "@engine/*": ["./engine/*"],
            "@vEngineLite/*": ["./src/vEngineLite/*"],
        },
        "incremental": true,
        "stripInternal": true,
        "resolveJsonModule": true,
        "jsx": "react",
        "jsxFactory": "VEngineTsxFactory.createElement",
        "jsxFragmentFactory": "VEngineTsxFactory.createFragment"
    },
    "exclude": [
        "node_modules",
        "node_tools"
    ],
    "watchOptions": {
        "excludeDirectories": ["**/node_modules", "./out/"]
    }
}
